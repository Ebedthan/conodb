function hydrophob(seq){
	hydro = ""
	aah=0
	len = split(seq, aa, "")
	for(p=1; p<=20; p++){
	    if(aa[p]=="A" || aa[p]=="I" || aa[p]=="L" || aa[p]=="F" || aa[p]=="M" || aa[p]=="W" || aa[p]=="Y" || aa[p]=="V" || aa[p]=="P" || aa[p]=="G"){
	    	aah+=1
	    }
	    else{
	    	aah+=0
	    }
	}
	if(len > 0 && len < 20){   	
	    hydro = (aah/len * 100)"%"
	}
	else{
	    hydro = (aah/20 * 100)"%"
	}
    return hydro
}

