#! /usr/bin/gawk -f

BEGIN{
		FS=OFS="|"
		
		print "Conopeptide|Read Name|Sequence Frequency|Protein Sequence|# A.A|# Cysteine(s)|% Hydrophobicity (Signal)|Superfamily (Signal)|Superfamily (Pro-region)|Superfamily (Mature)|Score Superfamily|Class (Signal)|Class (Pro-region)|Class (Mature)|Score Class" > "Regex.tab"
	}

# Trim sequences between STOP
# Discard sequence between last STOP and end of the read
# Discard lines without STOP

{
	for (i=2; i<=NF; i++){
		if ($i ~ /\*/){
			a = split($i, b, "*")
			for (j=1; j<=(a-1); j++){
				$i = b[j]
					
# Trim before 1st Methionine
# Discard sequences without Methionine					
					
				if(b[j] != "" && b[j] ~ /M/){
					b[j] = gensub(/^([^M]*)(M)(.*)$/,"\\2\\3","g",b[j])
						
### SEARCH SUPERFAMILIES & CLASSES (REGEX) ################################################
				    seq = b[j]
				    ss = superfam_signal(seq)
				    sp = superfam_pro(seq)
				    sm = superfam_mature(seq)
				    score_superfam = score(ss, sp, sm)
				    cs = class_signal(seq)
				    cp = class_pro(seq)
				    cm = class_mature(seq)
				    score_class = score(cs ,cp, cm)

				    if(score_superfam != "0" || score_class != "0"){
				    	seq_trim = trim_signal(seq, ss, cs)
				    	print search(seq_trim) FS $1"_"(i-1)"_"j FS (1 + count[seq_trim]++) FS seq_trim FS length(seq_trim) FS (split(seq_trim, cys,"C") - 1) FS hydrophob(seq_trim) FS ss FS sp FS sm FS score_superfam FS cs FS cp FS cm FS score_class > "regex.temp"
				    	}
					    		
				    if(score_superfam == 0){
				    	print ">" $1"_"(i-1)"_"j FS seq "\n" seq > "HMMER_input_superfam.fasta"
				    }
					    
				    if(score_class == 0){
				    	print ">" $1"_"(i-1)"_"j FS seq "\n" seq > "HMMER_input_class.fasta"
				    }    
			    }
			}
		}
    }
}
	
	
END{
	system("sort -t '|' -k 4 -nrk 3 regex.temp | sort -u -t'|' -k 4 >> Regex.tab")
	system("rm *.temp")
}

